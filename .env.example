# Hosted Claude through the Anthropic API (README vignette, smoke config).
ANTHROPIC_API_KEY=

# Hosted Claude / Gemini through Vertex AI (configs whose model starts with vertex_ai/).
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-east5
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: OpenAI-compatible models or proxies.
OPENAI_API_KEY=

# Optional: higher-throughput Semantic Scholar access for retrieval-heavy runs.
S2_API_KEY=

# Sufficiency-judge training data (scripts/sufficiency_classifier): NCBI contact email, optional key.
PUBMED_EMAIL=
PUBMED_API_KEY=

# Optional: contact email for Unpaywall full-text lookup.
UNPAYWALL_EMAIL=

# Local OpenAI-compatible endpoint (vLLM) serving the Qwen3.5-9B subagent used by the
# *_direct_* configs. Not needed for the smoke config.
LLM_BASE_URL=
